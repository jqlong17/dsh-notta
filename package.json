{
  "name": "dsh-notta",
  "version": "0.1.0",
  "description": "笔记面板：读取一个 Obsidian 资料库，按 Obsidian Flavored Markdown 渲染，支持编辑、Bases 视图和实时跟随磁盘变化。",
  "type": "module",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "vendor",
    "locale",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-locale"
      ],
      "immediately": true
    },
    "hub": {
      "summary": "笔记：左侧栏打开一个 Obsidian 兼容的资料库，左边文件树，右边阅读视图。"
    }
  },
  "scripts": {
    "build": "node ./scripts/build-host.mjs && node ./scripts/build-client.mjs && node ./scripts/build-editor.mjs",
    "build:host": "node ./scripts/build-host.mjs",
    "build:client": "node ./scripts/build-client.mjs",
    "check:vault": "node --experimental-strip-types ./scripts/check-vault.mjs",
    "test:routes": "node --experimental-strip-types ./scripts/test-routes.mjs",
    "test": "npm run check:vault && npm run test:routes",
    "build:editor": "node ./scripts/build-editor.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@type32/obsidian-bases-parser": "^0.5.1",
    "highlight.js": "^11.11.1",
    "katex": "^0.16.22",
    "mdian": "^0.3.7",
    "mermaid": "^11.12.0",
    "pdfjs-dist": "^4.10.38",
    "react-markdown": "^9.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "esbuild": "^0.25.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "engines": {
    "dsh": ">=0.2.2-rc.1",
    "node": ">=22.15"
  },
  "license": "MIT",
  "author": "jqlong17",
  "homepage": "https://github.com/jqlong17/dsh-notta",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jqlong17/dsh-notta.git"
  },
  "bugs": {
    "url": "https://github.com/jqlong17/dsh-notta/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "obsidian",
    "notes",
    "markdown",
    "bases",
    "笔记"
  ]
}
